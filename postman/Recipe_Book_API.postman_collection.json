        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Plov (family recipe)\",\n  \"cuisine\": \"Uzbek\",\n  \"category\": \"main\",\n  \"cook_time_minutes\": 100,\n  \"servings\": 8,\n  \"ingredients\": [\n    {\n      \"name\": \"Rice\",\n      \"amount\": \"500 g\"\n    },\n    {\n      \"name\": \"Beef\",\n      \"amount\": \"600 g\"\n    },\n    {\n      \"name\": \"Carrots\",\n      \"amount\": \"600 g\"\n    },\n    {\n      \"name\": \"Onions\",\n      \"amount\": \"2 pcs\"\n    }\n  ],\n  \"instructions\": \"Fry the meat, add onions and carrots, add rice and water, cook covered.\",\n  \"favorite\": false\n}",
          "options": {
